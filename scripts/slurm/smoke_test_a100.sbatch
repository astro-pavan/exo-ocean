#!/bin/bash
# Runs experiments/tests/smoke_test_a100.jl on CSD3 (one A100). Generated by scripts/generate_slurm_script.py.
#   cd <repo root> && mkdir -p logs && sbatch scripts/slurm/smoke_test_a100.sbatch
#SBATCH -J smoke_test_a100
#SBATCH -A SHORTTLE-SL3-GPU
#SBATCH -p ampere
#SBATCH -N1
#SBATCH -n1
#SBATCH --time=01:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --gres=gpu:1
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=pt426@cam.ac.uk

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
[ -f "experiments/tests/smoke_test_a100.jl" ] || { echo "submit from the repo root: experiments/tests/smoke_test_a100.jl not found in $PWD"; exit 1; }
source env.sh
export EXO_EMULATOR_PYTHON=$HOME/ocean-venv/bin/python
export LD_LIBRARY_PATH=$(echo "${LD_LIBRARY_PATH:-}" | tr ':' '\n' | grep -vi cuda | paste -sd: || true)    # CUDA.jl loads its own libraries
echo "$(date '+%F %T')  experiments/tests/smoke_test_a100.jl on $(hostname): $(nvidia-smi --query-gpu=name --format=csv,noheader)"
julia --project=. -t auto experiments/tests/smoke_test_a100.jl
echo "$(date '+%F %T')  experiments/tests/smoke_test_a100.jl finished"
